@startuml System Class Diagram
!theme plain
title ZAI E-commerce Platform - Diagramme de Classes du Système

package "Controllers" {
    class AuthController {
        +login(email, password)
        +register(userData)
        +logout()
        +resetPassword(email)
        +verifyToken(token)
        -validateCredentials(email, password)
        -generateToken(userId)
    }
    
    class ProductController {
        +getAllProducts()
        +getProductById(id)
        +searchProducts(query)
        +getProductsByCategory(categoryId)
        +getProductDetails(id)
        -formatProductData(product)
    }
    
    class CartController {
        +addToCart(userId, productId, quantity)
        +removeFromCart(userId, productId)
        +updateQuantity(userId, productId, quantity)
        +getCartItems(userId)
        +clearCart(userId)
        -validateCartItem(productId, quantity)
    }
    
    class OrderController {
        +createOrder(orderData)
        +getOrderById(orderId)
        +getUserOrders(userId)
        +updateOrderStatus(orderId, status)
        +cancelOrder(orderId)
        -calculateOrderTotal(items)
        -processPayment(paymentData)
    }
    
    class CheckoutController {
        +startCheckout(userId)
        +processCheckout(checkoutData)
        +validateOrder(orderData)
        +confirmPayment(paymentResult)
        -applyPromotions(items, promoCode)
        -calculateShipping(address)
    }
    
    class TicketsController {
        +createTicket(ticketData)
        +getTicketById(ticketId)
        +getUserTickets(userId)
        +updateTicketStatus(ticketId, status)
        +addTicketResponse(ticketId, response)
        -assignTicketToAgent(ticketId)
    }
    
    class UserController {
        +getUserProfile(userId)
        +updateProfile(userId, profileData)
        +changePassword(userId, oldPassword, newPassword)
        +getOrderHistory(userId)
        -validateProfileData(profileData)
    }
    
    class CategoryController {
        +getAllCategories()
        +getCategoryById(id)
        +getCategoryProducts(categoryId)
        +createCategory(categoryData)
        +updateCategory(id, categoryData)
    }
}

package "Models" {
    abstract class BaseModel {
        #db: PDO
        #table: string
        +__construct()
        +find(id)
        +findAll()
        +create(data)
        +update(id, data)
        +delete(id)
        #executeQuery(sql, params)
        #validateData(data)
    }
    
    class User extends BaseModel {
        -id: int
        -email: string
        -password: string
        -firstName: string
        -lastName: string
        -phone: string
        -address: string
        -createdAt: DateTime
        -updatedAt: DateTime
        +authenticate(email, password): bool
        +hashPassword(password): string
        +verifyPassword(password, hash): bool
        +getFullName(): string
        +isActive(): bool
    }
    
    class Product extends BaseModel {
        -id: int
        -name: string
        -description: string
        -price: float
        -stock: int
        -categoryId: int
        -imageUrl: string
        -isActive: bool
        -createdAt: DateTime
        +isInStock(): bool
        +getFormattedPrice(): string
        +updateStock(quantity): bool
        +getCategory(): Category
    }
    
    class Category extends BaseModel {
        -id: int
        -name: string
        -description: string
        -parentId: int
        -isActive: bool
        +getProducts(): array
        +getSubCategories(): array
        +getParentCategory(): Category
        +hasProducts(): bool
    }
    
    class Cart extends BaseModel {
        -id: int
        -userId: int
        -productId: int
        -quantity: int
        -addedAt: DateTime
        +getTotal(): float
        +getItemCount(): int
        +isEmpty(): bool
        +getProduct(): Product
    }
    
    class Order extends BaseModel {
        -id: int
        -userId: int
        -orderNumber: string
        -status: string
        -totalAmount: float
        -shippingAddress: string
        -paymentMethod: string
        -paymentStatus: string
        -createdAt: DateTime
        -updatedAt: DateTime
        +getOrderItems(): array
        +calculateTotal(): float
        +updateStatus(status): bool
        +canBeCancelled(): bool
        +getUser(): User
    }
    
    class Ticket extends BaseModel {
        -id: int
        -userId: int
        -subject: string
        -description: string
        -status: string
        -priority: string
        -assignedTo: int
        -createdAt: DateTime
        -updatedAt: DateTime
        +addResponse(response): bool
        +assignToAgent(agentId): bool
        +close(): bool
        +getResponses(): array
        +getUser(): User
    }
}

package "Services" {
    class DolibarrService {
        -apiUrl: string
        -apiKey: string
        -timeout: int
        +authenticate(): bool
        +createProduct(productData): int
        +updateProduct(id, productData): bool
        +createOrder(orderData): int
        +updateOrderStatus(orderId, status): bool
        +getCustomer(customerId): array
        +createCustomer(customerData): int
        -makeApiCall(endpoint, method, data): array
        -handleApiError(response): void
    }
}

package "Utils" {
    class DolibarrIntegration {
        -service: DolibarrService
        +syncProduct(product): bool
        +syncOrder(order): bool
        +syncCustomer(user): bool
        +getProductStock(productId): int
        +updateProductStock(productId, quantity): bool
        -mapProductData(product): array
        -mapOrderData(order): array
    }
    
    class DolibarrDatabase {
        -connection: PDO
        +getProducts(): array
        +getProductById(id): array
        +getOrders(): array
        +getCustomers(): array
        +updateProductStock(productId, stock): bool
        -executeQuery(sql, params): array
    }
}

package "Middleware" {
    class AuthMiddleware {
        +handle(request, response, next)
        +requireAuth()
        +requireAdmin()
        +checkPermissions(permission)
        -validateToken(token): bool
        -getUserFromToken(token): User
    }
}

package "Helpers" {
    class ErrorHandler {
        +handleException(exception)
        +logError(message, context)
        +renderErrorPage(code, message)
        +sendErrorResponse(code, message)
        -formatErrorMessage(exception): string
    }
}

' Relations entre les classes
AuthController --> User : utilise
ProductController --> Product : utilise
CartController --> Cart : utilise
CartController --> Product : utilise
OrderController --> Order : utilise
OrderController --> User : utilise
CheckoutController --> Cart : utilise
CheckoutController --> Order : utilise
TicketsController --> Ticket : utilise
UserController --> User : utilise
CategoryController --> Category : utilise

User ||--o{ Cart : possède
User ||--o{ Order : passe
User ||--o{ Ticket : crée
Product ||--o{ Cart : contenu dans
Category ||--o{ Product : contient
Order ||--o{ Cart : créé depuis

DolibarrService <-- DolibarrIntegration : utilise
DolibarrIntegration --> Product : synchronise
DolibarrIntegration --> Order : synchronise
DolibarrIntegration --> User : synchronise

AuthMiddleware --> User : authentifie
ErrorHandler <-- AuthController : utilise
ErrorHandler <-- ProductController : utilise
ErrorHandler <-- OrderController : utilise

note top of BaseModel
  Classe abstraite fournissant
  les opérations CRUD de base
  pour tous les modèles
end note

note top of DolibarrService
  Service de communication
  avec l'API Dolibarr pour
  la synchronisation des données
end note

note top of AuthMiddleware
  Middleware d'authentification
  pour sécuriser les routes
  et vérifier les permissions
end note

@enduml